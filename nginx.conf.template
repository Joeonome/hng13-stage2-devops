# ================================
# HNG 13 Stage 3 - Nginx Template
# Observability & Alerts Extension
# ================================

# Custom log format capturing key metrics and tracing headers
log_format stage3_format '$remote_addr - $remote_user [$time_local] "$request" '
                         '$status $body_bytes_sent "$http_referer" '
                         '"$http_user_agent" "$http_x_forwarded_for" '
                         'pool=$http_x_app_pool release=$http_x_release_id '
                         'upstream_status=$upstream_status '
                         'upstream_addr=$upstream_addr '
                         'request_time=$request_time '
                         'upstream_response_time=$upstream_response_time';

access_log /var/log/nginx/access.log stage3_format;
error_log /var/log/nginx/error.log warn;

# =================================================
# Upstream configuration for Blue/Green deployment
# =================================================
upstream app_backend {
    server app_blue:8081 max_fails=1 fail_timeout=3s;
    server app_green:8082 backup;
}

server {
    listen 80;

    location / {
        proxy_pass http://app_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ✅ Forward headers as-is (don’t overwrite)
        # Removed invalid directive `proxy_pass_request_headers on;`
        # (Nginx would fail to start otherwise)

        proxy_connect_timeout 2s;
        proxy_send_timeout 5s;
        proxy_read_timeout 5s;
        proxy_next_upstream error timeout http_500 http_502 http_503 http_504;
    }

    location /health {
        proxy_pass http://app_backend;
        add_header X-App-Pool $upstream_addr;
    }
}
